# NanoClaw OpenCode Edition — Environment Configuration
#
# AI Provider API Keys (configure at least one)
# OpenCode is provider-agnostic; set the key for your preferred provider.
#
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# XAI_API_KEY=xai-...

# Assistant configuration
# ASSISTANT_NAME=Andy
# ASSISTANT_HAS_OWN_NUMBER=false

# 6551 API tokens (for OpenTwitter and OpenNews skills)
# TWITTER_TOKEN=your-6551-twitter-token
# OPENNEWS_TOKEN=your-6551-opennews-token

# Container configuration
# CONTAINER_IMAGE=nanoclaw-agent:latest
# CONTAINER_TIMEOUT=1800000
# IDLE_TIMEOUT=1800000
# MAX_CONCURRENT_CONTAINERS=5
